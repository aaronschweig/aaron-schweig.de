---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
---

<Layout>
  <!-- Hero -->
  <main class="flex flex-1 items-center px-6 py-10">
    <div class="mx-auto w-full max-w-3xl text-center">
      <!-- Brand logo. In dark mode the navy/gray artwork sits on a light plate
           for legibility; in light mode the plate is transparent (see tokens). -->
      <div
        class="mx-auto flex w-full max-w-md items-center justify-center rounded-2xl bg-logo-plate px-8 py-6 shadow-2xl shadow-black/20 ring-1 ring-logo-plate-ring"
      >
        <Image
          src={logo}
          alt="Aaron Schweig — Flugausbildung & Aviation Services"
          class="h-auto w-full"
          loading="eager"
        />
      </div>

      <!-- Badge / Tag -->
      <!--
      <div class="mt-6 sm:mt-10">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-electric/30 bg-electric/10 px-4 py-1.5 text-xs font-medium tracking-widest text-electric uppercase"
        >
          <span
            class="inline-block h-1.5 w-1.5 rounded-full bg-electric"
            aria-hidden="true"></span>
          CPL(A) &bull; FI(A) &bull; ME/SE-IR
        </span>
      </div>
      -->

      <!-- Main heading (real slogan) -->
      <h1
        class="mt-5 text-3xl leading-tight font-bold tracking-tight text-balance text-heading sm:mt-8 sm:text-5xl md:text-6xl"
      >
        Flight Training&nbsp;
        <span class="text-electric">&amp;</span> Aviation Services
      </h1>

      <!-- Subline -->
      <p
        class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-pretty text-text sm:mt-6 sm:text-lg"
      >
        <!--Flugausbildung, Proficiency Checks und Safety-Pilot-Services mit Basis
        in <span class="font-medium text-heading">EDFM (Mannheim)</span>.-->
        Die Website befindet sich derzeit im Aufbau.
      </p>

      <!-- Action & Contact -->
      <div
        class="mt-6 flex flex-col items-center justify-center gap-4 sm:mt-10 sm:flex-row"
      >
        <a
          href="mailto:contact@aaron-schweig.de"
          class="group inline-flex items-center gap-2 rounded-lg bg-electric px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-electric/20 transition-all hover:bg-electric/90 hover:shadow-electric/30 focus-visible:ring-2 focus-visible:ring-electric focus-visible:ring-offset-2 focus-visible:ring-offset-bg focus-visible:outline-none"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          Email senden
        </a>
        <!--
        <a
          href="https://linkedin.com/in/aaron-schweig-471707199"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-semibold text-text transition-colors hover:border-electric/50 hover:text-heading focus-visible:ring-2 focus-visible:ring-electric focus-visible:ring-offset-2 focus-visible:ring-offset-bg focus-visible:outline-none"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-4 w-4"
            aria-hidden="true"
          >
            <path
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
            ></path>
          </svg>
          LinkedIn
        </a>
        -->
      </div>
    </div>
  </main>
</Layout>
